rules_version = '2';

// Security model for the tax deed dashboard sync (see docs/LOGIN_SETUP.md).
//
// Multi-tenant: each customer is a team. A team's root document carries its
// member list (members: {uid: true, ...}), set by the operator in the console
// at onboarding — never from the app. Team workspaces are fully isolated:
// a member of one team cannot read or write another team's lists.
//
// Access control is CLOSED SIGNUP: self-registration is never enabled, so
// the only authenticated users are the accounts the operator creates.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(teamId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.members[request.auth.uid] == true;
    }

    // Personal state (positions, notes, prefs, personal lists) and the
    // profile doc that names the user's team: only that account. The profile
    // doc's `team` field is set by the operator in the console at onboarding;
    // writes from the app never touch it (the app only writes users/{uid}/state).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // profile (team assignment) is operator-managed
    }
    match /users/{uid}/state/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Team root doc: members can see their own team's name/roster; membership
    // itself is operator-managed in the console.
    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow write: if false;
    }

    // Team workspace (shared lists + memberships): members only.
    match /teams/{teamId}/state/{doc} {
      allow read, write: if isMember(teamId);
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
