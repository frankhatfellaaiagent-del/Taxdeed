rules_version = '2';

// Security model for the tax deed dashboard sync (see docs/LOGIN_SETUP.md).
//
// Access control is CLOSED SIGNUP: self-registration is never enabled, so the
// only authenticated users that can exist are the accounts Frank creates in
// the Firebase console. That makes "any signed-in user" equivalent to "the
// MADD team" for the shared team documents.

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal state (positions, notes, prefs, personal lists):
    // readable and writable only by the account it belongs to.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared team state (team lists + which parcels are on them):
    // any signed-in team member can read and edit.
    match /teams/madd/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
